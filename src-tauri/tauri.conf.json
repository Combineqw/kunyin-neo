{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "昆音 (Kunyin Neo)",
  "version": "1.1.0",
  "identifier": "com.combineqw.kunyin.desktop",
  "build": {
    "frontendDist": "../out/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "昆音 (Kunyin Neo)",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data: https: http:; connect-src ipc: http://ipc.localhost https: http:"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["../resources/icons/icon.ico"]
  }
}
