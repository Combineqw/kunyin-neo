{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kunyin Native Rust",
  "version": "0.1.0",
  "identifier": "com.combineqw.kunyin.tauri-shell",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Kunyin Tauri Core Shell",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["../resources/icons/icon.ico"]
  }
}
